# Copy to .env and adjust. All paths are relative to project root unless absolute.

# Fetch: use playwright (1) or HTTP requests (0) for listing HTML
USE_PLAYWRIGHT=1
HEADLESS=1

# Politeness: seconds between listing index page fetches
REQUEST_DELAY_SEC=1.5
MAX_LISTING_PAGES=3

# Realt.by listing index (Minsk region / Минский район flats)
REALT_ACTIVE_BASE_URL=https://realt.by/sale/flats/minskij-rajon/

# Optional: CSV with columns district_key,archived_count for turnover_ratio
# (realt.by public HTML does not expose a reliable archive index; see README)
# Optional: district-level archived counts (see README)
# ARCHIVED_DISTRICT_CSV=data/archived_by_district.csv

# Geocoding (Nominatim requires identifying User-Agent). Same string is sent to Overpass API.
NOMINATIM_USER_AGENT=MinskPropertyAgent/1.0 (contact: you@example.com)

# OSM Overpass endpoint
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Open minsk_investor_report.html in the default browser after each run (same as --show)
SHOW_DASHBOARD=0

OUTPUT_CSV=property_data_final.csv
OUTPUT_HTML=minsk_investor_report.html

# Streamlit explorer: default CSV path (optional; can change in app sidebar)
# STREAMLIT_DATA_CSV=property_data_final.csv

# Geocode cache
GEOCODE_CACHE_PATH=data/geocode_cache.sqlite
